{
  "name": "apps-container",
  "private": true,
  "scripts": {
    "frontend:install": "cd apps/frontend && npm install",
    "frontend:dev": "cd apps/frontend && npm run dev",
    "frontend:build": "cd apps/frontend && npm run build",
    "test_service:install": "cd apps/test_service && npm install",
    "test_service:dev": "cd apps/test_service && npm run start:dev",
    "test_service:build": "cd apps/test_service && npm run build",
    "install:all": "npm run frontend:install && npm run test_service:install",
    "build:all": "npm run frontend:build && npm run test_service:build"
  }
}
